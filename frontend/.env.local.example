# Konfigurasi Frontend Next.js untuk Firebase Authentication & Backend API
# Nilai-nilai ini didapatkan secara gratis dari Dashboard Firebase Console

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=smart-pdf-system.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=smart-pdf-system
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=smart-pdf-system.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Alamat Backend FastAPI (saat pengujian gunakan http://localhost:8000 atau URL Render Anda)
NEXT_PUBLIC_API_URL=http://localhost:8000
