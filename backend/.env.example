# Contoh Konfigurasi Environment Backend Multi-Mode Smart PDF Processing System

# Lingkungan: development atau production
ENV=development
PORT=8000

# Daftar email yang diizinkan mengakses website (pisahkan dengan koma)
# Masukkan email Anda dan rekan yang diberi akses (maksimal 2-5 pengguna awal)
ALLOWED_EMAILS=emailanda@gmail.com,rekan1@gmail.com

# Alamat domain Frontend yang diizinkan mengakses API (CORS)
# Saat tahap awal biarkan "*" (semua), atau ganti dengan domain Cloudflare Pages Anda nanti
CORS_ORIGINS=*

# ID Proyek Firebase (didapatkan saat membuat proyek Firebase)
FIREBASE_PROJECT_ID=smart-pdf-system
